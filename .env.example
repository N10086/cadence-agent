# ============================================================
# 复制为 .env 后填写。.env 已在 .gitignore 中，永远不会被提交。
# ============================================================

# ---------- 数据库（与 ecom-* 一套错开）----------
# 宿主端口 5433 → 容器 5432
POSTGRES_DB=TODO
DB_USER=cadence
DB_PASSWORD=cadence
DB_URL=jdbc:postgresql://localhost:5433/TODO
DATABASE_URL=postgresql://cadence:cadence@localhost:5433/TODO

# ---------- Core（Java）----------
# 18080，避开 ecom-nginx 占用的 8080
CORE_PORT=18080
CORE_BASE_URL=http://localhost:18080

# ---------- Agent（Python，SP2）----------
# 18000，避开 ecom-gateway 占用的 8000
AGENT_PORT=18000
AGENT_BASE_URL=http://localhost:18000
LOG_LEVEL=INFO

# auto = 有 DEEPSEEK_API_KEY 就走真实模型，没有就自动进 fake 模式
# fake = 强制离线（零成本、确定性，跑测试和演示用）
LLM_MODE=auto

# L4 评测冻结时钟（ISO8601，带时区）。留空 = 真实时间；
# 外部 live Agent 跑评测时设成 2026-11-08T10:30:00+08:00，题面里的"今天/本周三"才可复现。
EVAL_FROZEN_NOW=

# 一次请求最多几步（超了就中止并汇报已完成的进度）
STEP_BUDGET=8
# 单次上下文预算（unit: token），超了触发历史压缩
MAX_CONTEXT_TOKENS=4000
# 整轮累计计费 token 上限。注意每步都会重发上下文，3 步约为单步的 3 倍
TOKEN_BUDGET_PER_TURN=20000

# 只有双模型时才值得打开：多一次"这句话难不难"的调用
ROUTER_LLM_VERDICT=false

# ---------- 快模型：复杂度判定 / 槽位抽取 / 结果复述 ----------
# 不配也能跑：此时全部走 DeepSeek，但 fast 路径的延迟和成本会达标不了（见 README §7）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ---------- 推理模型：任务分解 / 复杂规划 / 解释生成 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
# 快层：同一模型的非 reasoning 别名（路由判定"不需要推理"时用）
DEEPSEEK_FAST_MODEL=deepseek-chat

# ---------- Web（Python，W11 开始用）----------
WEB_PORT=15500
# 两级工具注入：先选类别（read/write/destructive/control）再发该类 schema；false = 全量注入
TOOL_CATEGORY_ROUTING=true
